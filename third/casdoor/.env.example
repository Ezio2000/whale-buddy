# Casdoor image. Keep this pinned; do not use "latest" in long-running deployments.
CASDOOR_VERSION=3.164.0
MYSQL_IMAGE=mysql:8.0

# Optional Docker Hub proxy prefix, without credentials or query parameters.
# Leave empty to use Docker Hub. A command-line --registry-prefix overrides it.
REGISTRY_PREFIX=

# Local standard OAuth/OIDC mock. Test/debug only; it is not a WeCom protocol mock.
OAUTH_MOCK_PORT=9000
# Optional URL encoded into the QR code. Leave empty to auto-detect this machine's LAN IP.
OAUTH_MOCK_SCAN_BASE_URL=

# Host-side listener and the final URL users will open.
CASDOOR_PORT=8000
CASDOOR_ORIGIN=http://127.0.0.1:8000
CASDOOR_START_TIMEOUT=120

# Existing external MySQL server, reachable from Docker.
# On Docker Desktop, use host.docker.internal for a MySQL server on this host.
MYSQL_HOST=192.0.2.10
MYSQL_PORT=3306
MYSQL_DATABASE=casdoor
MYSQL_CONNECT_TIMEOUT=60

# Administrative credentials are used only by short-lived mysql client containers
# to create the database and runtime account. They are not passed to Casdoor.
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD='replace-with-admin-password'

# Casdoor receives only this database-scoped runtime account.
# Use letters, numbers, dot, underscore, tilde, colon, @, +, =, !, #, %, ^, * or -.
MYSQL_APP_USER=casdoor
MYSQL_APP_PASSWORD='replace-with-app-password'
