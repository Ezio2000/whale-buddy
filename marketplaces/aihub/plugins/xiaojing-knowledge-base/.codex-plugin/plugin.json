{
  "name": "xiaojing-knowledge-base",
  "version": "0.1.4",
  "description": "统一使用小鲸知识库和 Outlook，查询内部资料、日历、通讯录与邮件。",
  "author": {
    "name": "AI小鲸"
  },
  "interface": {
    "displayName": "小鲸 AIHub",
    "shortDescription": "知识库与 Outlook，共用一个连接。",
    "longDescription": "一次配置 AIHub，即可检索授权知识库和使用 Outlook。邮箱能力取决于账号开通状态，知识库可独立使用。发送邮件前生成预览并等待确认。",
    "developerName": "AI小鲸",
    "category": "Productivity",
    "capabilities": [
      "MCP",
      "Knowledge Base",
      "Outlook",
      "Mail"
    ],
    "brandColor": "#347B78",
    "defaultPrompt": [
      "列出我能访问的广汽知识库。",
      "在知识库中搜索相关制度。"
    ]
  },
  "skills": "./skills/",
  "mcpServers": "./.mcp.json",
  "whale": {
    "apiVersion": 2,
    "uiContributions": [
      {
        "id": "knowledge-command",
        "type": "action",
        "placement": "commandPalette",
        "entry": "./ui/index.html",
        "title": "浏览小鲸知识库",
        "description": "读取并浏览当前账号获授权的知识库。",
        "keywords": [
          "知识库",
          "小鲸",
          "AIHub",
          "dataset"
        ],
        "order": 100
      },
      {
        "id": "knowledge-thread-action",
        "type": "action",
        "placement": "threadToolbar",
        "entry": "./ui/index.html",
        "title": "线程知识库",
        "order": 100
      },
      {
        "id": "knowledge-composer-action",
        "type": "action",
        "placement": "composerToolbar",
        "entry": "./ui/index.html",
        "title": "选择知识库",
        "order": 100
      },
      {
        "id": "knowledge-message-card",
        "type": "card",
        "placement": "message",
        "entry": "./ui/index.html",
        "title": "小鲸知识库结果",
        "match": {
          "itemTypes": [
            "mcpToolCall"
          ],
          "server": "xiaojing-knowledge-base",
          "tools": [
            "gac_kb_list_datasets",
            "gac_kb_search",
            "gac_kb_search_scoped"
          ]
        },
        "order": 100
      },
      {
        "id": "outlook-navigation",
        "type": "page",
        "placement": "navigation",
        "entry": "./ui/index.html",
        "title": "Outlook",
        "order": 110
      },
      {
        "id": "outlook-command",
        "type": "action",
        "placement": "commandPalette",
        "entry": "./ui/index.html",
        "title": "打开 Outlook 助手",
        "description": "查看日历、联系人、邮件及安全发送能力。",
        "keywords": [
          "Outlook",
          "日历",
          "联系人",
          "邮件"
        ],
        "order": 110
      },
      {
        "id": "outlook-message-card",
        "type": "card",
        "placement": "message",
        "entry": "./ui/index.html",
        "title": "Outlook 结果",
        "match": {
          "itemTypes": [
            "mcpToolCall"
          ],
          "server": "xiaojing-knowledge-base",
          "tools": [
            "outlook_calendar_search",
            "outlook_directory_search",
            "outlook_contact_search",
            "outlook_mail_search",
            "outlook_mail_get",
            "outlook_mail_send_preview",
            "outlook_mail_reply_preview",
            "outlook_mail_send",
            "outlook_mail_action_cancel",
            "outlook_mail_history",
            "outlook_mail_history_get"
          ]
        },
        "order": 110
      }
    ],
    "webMcp": {
      "entry": "./ui/index.html",
      "tools": [
        {
          "id": "list-knowledge-bases",
          "name": "xiaojing_list_knowledge_bases",
          "title": "列出小鲸知识库",
          "description": "列出当前账号有权访问的小鲸知识库。",
          "scope": "global",
          "inputSchema": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          },
          "annotations": {
            "readOnlyHint": true,
            "untrustedContentHint": true
          }
        },
        {
          "id": "set-knowledge-scope",
          "name": "xiaojing_set_knowledge_scope",
          "title": "设置线程知识库范围",
          "description": "为当前线程选择后续知识检索使用的知识库。",
          "scope": "thread",
          "inputSchema": {
            "type": "object",
            "properties": {
              "datasets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "name"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "datasets"
            ],
            "additionalProperties": false
          },
          "annotations": {
            "readOnlyHint": false,
            "untrustedContentHint": false
          }
        },
        {
          "id": "clear-knowledge-scope",
          "name": "xiaojing_clear_knowledge_scope",
          "title": "清除线程知识库范围",
          "description": "清除当前线程已选择的知识库范围。",
          "scope": "thread",
          "inputSchema": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          },
          "annotations": {
            "readOnlyHint": false,
            "untrustedContentHint": false
          }
        }
      ]
    },
    "credentials": [
      {
        "id": "aihub-token",
        "key": "aihub/token",
        "credentialType": "bearerToken",
        "label": "AIHub MCP API Key",
        "description": "知识库与 Outlook 共用的 AIHub MCP API Key。",
        "env": "AIHUB_MCP_TOKEN",
        "required": true,
        "scope": "marketplace",
        "usedBy": {
          "mcpServers": [
            "xiaojing-knowledge-base"
          ]
        }
      }
    ],
    "permissions": {
      "mcp": [
        {
          "principal": "webMcp:list-knowledge-bases",
          "server": "xiaojing-knowledge-base",
          "tools": [
            "gac_kb_list_datasets"
          ]
        },
        {
          "principal": "webMcp:set-knowledge-scope",
          "server": "xiaojing-knowledge-base",
          "tools": [
            "gac_kb_search_scoped"
          ]
        }
      ]
    }
  }
}
