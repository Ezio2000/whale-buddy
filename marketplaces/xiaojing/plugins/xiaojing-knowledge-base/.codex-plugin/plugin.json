{
  "name": "xiaojing-knowledge-base",
  "version": "0.3.1+codex.20260901141000",
  "description": "\u641c\u7d22\u5f53\u524d\u7528\u6237\u83b7\u6388\u6743\u7684\u5e7f\u6c7d\u77e5\u8bc6\u5e93\u3002",
  "author": {
    "name": "AI\u5c0f\u9cb8"
  },
  "interface": {
    "displayName": "\u5c0f\u9cb8\u77e5\u8bc6\u5e93",
    "shortDescription": "\u5217\u51fa\u5e76\u641c\u7d22\u83b7\u6388\u6743\u7684\u5e7f\u6c7d\u77e5\u8bc6\u5e93\u3002",
    "longDescription": "\u901a\u8fc7 AIHub MCP \u5217\u51fa\u5f53\u524d\u8d26\u53f7\u53ef\u8bbf\u95ee\u7684\u6570\u636e\u96c6\uff0c\u5e76\u6309\u5173\u952e\u8bcd\u68c0\u7d22\u77e5\u8bc6\u5e93\u6587\u672c\u548c\u56fe\u7247\u5185\u5bb9\u3002",
    "developerName": "AI\u5c0f\u9cb8",
    "category": "Productivity",
    "capabilities": [
      "MCP",
      "Knowledge Base",
      "Search"
    ],
    "brandColor": "#347B78",
    "defaultPrompt": [
      "\u5217\u51fa\u6211\u80fd\u8bbf\u95ee\u7684\u5e7f\u6c7d\u77e5\u8bc6\u5e93\u3002",
      "\u5728\u77e5\u8bc6\u5e93\u4e2d\u641c\u7d22\u76f8\u5173\u5236\u5ea6\u3002"
    ]
  },
  "skills": "./skills/",
  "mcpServers": "./.mcp.json",
  "whale": {
    "apiVersion": 2,
    "uiContributions": [
      {
        "id": "knowledge-navigation",
        "type": "page",
        "placement": "navigation",
        "entry": "./ui/index.html",
        "title": "小鲸知识库",
        "order": 100
      },
      {
        "id": "knowledge-command",
        "type": "action",
        "placement": "commandPalette",
        "entry": "./ui/index.html",
        "title": "浏览小鲸知识库",
        "description": "读取并浏览当前账号获授权的知识库。",
        "keywords": [
          "知识库",
          "小鲸",
          "AIHub",
          "dataset"
        ],
        "order": 100
      },
      {
        "id": "knowledge-thread-action",
        "type": "action",
        "placement": "threadToolbar",
        "entry": "./ui/index.html",
        "title": "线程知识库",
        "order": 100
      },
      {
        "id": "knowledge-composer-action",
        "type": "action",
        "placement": "composerToolbar",
        "entry": "./ui/index.html",
        "title": "选择知识库",
        "order": 100
      },
      {
        "id": "knowledge-message-card",
        "type": "card",
        "placement": "message",
        "entry": "./ui/index.html",
        "title": "小鲸知识库结果",
        "match": {
          "itemTypes": ["mcpToolCall"],
          "server": "xiaojing-knowledge-base",
          "tools": ["gac_kb_list_datasets", "gac_kb_search"]
        },
        "order": 100
      }
    ],
    "webMcp": {
      "entry": "./ui/index.html",
      "tools": [
        {
          "id": "list-knowledge-bases",
          "name": "xiaojing_list_knowledge_bases",
          "title": "列出小鲸知识库",
          "description": "列出当前账号有权访问的小鲸知识库。",
          "scope": "global",
          "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
          "annotations": { "readOnlyHint": true, "untrustedContentHint": true }
        },
        {
          "id": "set-knowledge-scope",
          "name": "xiaojing_set_knowledge_scope",
          "title": "设置线程知识库范围",
          "description": "为当前线程选择后续知识检索使用的知识库。",
          "scope": "thread",
          "inputSchema": {
            "type": "object",
            "properties": {
              "datasets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": { "id": { "type": "string" }, "name": { "type": "string" } },
                  "required": ["id", "name"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["datasets"],
            "additionalProperties": false
          },
          "annotations": { "readOnlyHint": false, "untrustedContentHint": false }
        },
        {
          "id": "clear-knowledge-scope",
          "name": "xiaojing_clear_knowledge_scope",
          "title": "清除线程知识库范围",
          "description": "清除当前线程已选择的知识库范围。",
          "scope": "thread",
          "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
          "annotations": { "readOnlyHint": false, "untrustedContentHint": false }
        }
      ]
    },
    "credentials": [
      {
        "id": "aihub-token",
        "key": "aihub/token",
        "credentialType": "bearerToken",
        "label": "AIHub Token",
        "description": "\u7528\u4e8e\u8bbf\u95ee\u5c0f\u9cb8\u77e5\u8bc6\u5e93\u548c Outlook \u670d\u52a1\u3002",
        "env": "AIHUB_MCP_TOKEN",
        "required": true,
        "scope": "marketplace",
        "usedBy": {
          "mcpServers": [
            "xiaojing-knowledge-base"
          ]
        }
      }
    ],
    "permissions": {
      "mcp": [
      {
        "principal": "webMcp:list-knowledge-bases",
        "server": "xiaojing-knowledge-base",
        "tools": ["gac_kb_list_datasets"]
      },
      {
        "principal": "webMcp:set-knowledge-scope",
        "server": "xiaojing-knowledge-base",
        "tools": ["gac_kb_search"]
      }
      ]
    }
  }
}
