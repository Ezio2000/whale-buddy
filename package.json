{
  "name": "whale-buddy",
  "productName": "Whale Buddy",
  "version": "0.1.1",
  "description": "A macOS and Windows desktop client for Codex app-server",
  "author": "AI小鲸",
  "private": true,
  "main": ".vite/build/main.js",
  "scripts": {
    "codex:build": "node scripts/build-codex.mjs",
    "protocol:generate": "node scripts/generate-protocol.mjs",
    "protocol:check": "node scripts/check-protocol.mjs",
    "plugins:build": "vite build --config marketplaces/xiaojing/plugins/xiaojing-knowledge-base/vite.config.ts && vite build --config marketplaces/office/plugins/whale-office-assistant/vite.config.ts",
    "sidecar:check": "node scripts/check-sidecar.mjs",
    "predev": "pnpm sidecar:check",
    "dev": "electron-forge start",
    "start": "electron-forge start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/test-e2e.mjs",
    "platform:check": "node scripts/check-platform-boundary.mjs",
    "test:package:windows-layout": "node scripts/platform/windows/check-package-layout.mjs",
    "test:smoke": "node scripts/smoke-app-server.mjs",
    "app:run": "node scripts/build-and-run.mjs run",
    "app:verify": "node scripts/build-and-run.mjs verify",
    "build": "pnpm plugins:build && pnpm typecheck && pnpm sidecar:check && electron-forge package",
    "make": "pnpm plugins:build && pnpm typecheck && pnpm sidecar:check && electron-forge make"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-select": "^2.2.5",
    "@tanstack/react-virtual": "^3.13.12",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.0",
    "docx": "^9.7.1",
    "electron-squirrel-startup": "^1.0.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.525.0",
    "mammoth": "^1.12.2",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.1.0",
    "react-diff-view": "^3.3.2",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.7.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.1",
    "@electron-forge/maker-dmg": "^7.8.1",
    "@electron-forge/maker-squirrel": "^7.8.1",
    "@electron-forge/maker-zip": "^7.8.1",
    "@electron-forge/plugin-vite": "^7.8.1",
    "@electron-forge/shared-types": "^7.8.1",
    "@playwright/test": "^1.54.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^24.0.13",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^37.2.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.21.0"
}
